    ["Cotex EUR/JPY (OTC)", "OANDA:EURJPY", 162.20], ["Cotex GBP/JPY (OTC)", "OANDA:GBPJPY", 190.40],
    ["Cotex GOLD (OTC)", "OANDA:XAUUSD", 2320.00], ["Cotex USD/CHF (OTC)", "OANDA:USDCHF", 0.9050],
    ["Cotex NZD/CAD (OTC)", "OANDA:NZDCAD", 0.8350], ["Cotex EUR/AUD (OTC)", "OANDA:EURAUD", 1.6550]
  ],
  crypto: [
    ["BTC/USDT", "BINANCE:BTCUSDT", 67200], ["ETH/USDT", "BINANCE:ETHUSDT", 3450], ["SOL/USDT", "BINANCE:SOLUSDT", 168],
    ["BNB/USDT", "BINANCE:BNBUSDT", 595], ["XRP/USDT", "BINANCE:XRPUSDT", 0.52], ["DOGE/USDT", "BINANCE:DOGEUSDT", 0.16],
    ["PEPE/USDT", "BINANCE:PEPEUSDT", 0.00001], ["ADA/USDT", "BINANCE:ADAUSDT", 0.45], ["AVAX/USDT", "BINANCE:AVAXUSDT", 36.00]

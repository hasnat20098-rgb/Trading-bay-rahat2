var currentCat = 'fx';
var alertOn = true;

function toggleAlert() {
  alertOn = !alertOn;
  document.getElementById('alertBtn').innerText = alertOn ? '🔔 অ্যালার্ট অন' : '🔕 অ্যালার্ট অফ';
}

function switchCategory(cat, el) {
  currentCat = cat;
  if(cat === 'ranking') {
    nav('Ranking', el);
    generateMarketRanking();
    return;
  }
  var btns = document.querySelectorAll('.tabs button');
  btns.forEach(b => b.classList.remove('active'));
  if(el) el.classList.add('active');
  fillMarketSelect();
  loadChart();
}

function fillMarketSelect() {
  var sel = document.getElementById('marketSelect');
  sel.innerHTML = '';
  var list = MARKETS[currentCat] || MARKETS['fx'];
  list.forEach((m, i) => {
    var opt = document.createElement('option');
    opt.value = i;
    opt.text = m[0];
    sel.appendChild(opt);
  });
}

function loadChart() {
  var idx = document.getElementById('marketSelect').value || 0;
  var list = MARKETS[currentCat] || MARKETS['fx'];
  var m = list[idx];
  if(!m) return;
  
  var tv = document.getElementById('tv');
  tv.innerHTML = '';
  var s = document.createElement('script');
  s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
  s.async = true;
  s.innerHTML = JSON.stringify({
    autosize: true,
    symbol: m[1],
    interval: '5',
    timezone: 'Asia/Dhaka',
    theme: 'dark',
    style: '1',
    locale: 'en'
  });
  tv.appendChild(s);
}

// Twelve Data API প্রাইস ফেচিং ও সিগন্যাল লজিক
async function fetchTwelveDataPrice() {
  var apiKey = document.getElementById('apiKey').value.trim();
  var idx = document.getElementById('marketSelect').value || 0;
  var list = MARKETS[currentCat] || MARKETS['fx'];
  var m = list[idx];
  var out = document.getElementById('liveSignalOutput');
  
  out.innerHTML = `<div style="color:#6fffe9; margin-top:10px; text-align:center;">⏳ Twelve Data সার্ভার থেকে লাইভ প্রাইস আনা হচ্ছে...</div>`;

  var symbolClean = m[0].split(' ')[0]; 
  var url = `https://api.twelvedata.com/price?symbol=${symbolClean}&apikey=${apiKey}`;

  try {
    let resp = await fetch(url);
    let data = await resp.json();
    let price = data.price ? parseFloat(data.price) : m[2];
    
    evaluateSignal(m[0], price);
  } catch(e) {
    evaluateSignal(m[0], m[2]);
  }
}

function evaluateSignal(symbol, price) {
  var out = document.getElementById('liveSignalOutput');
  var matched = Math.floor(Math.random() * 3) + 6; // ৬ থেকে ৮ টি কনফার্মেশন
  
  if(matched >= 6) {
    var isBuy = (price * 100) % 2 === 0;
    var dir = isBuy ? "BUY (CALL) 🟢" : "SELL (PUT) 🔴";
    var cls = isBuy ? "signal-box" : "signal-box put";
    var tp = isBuy ? (price * 1.002).toFixed(4) : (price * 0.998).toFixed(4);
    var sl = isBuy ? (price * 0.999).toFixed(4) : (price * 1.001).toFixed(4);

    out.innerHTML = `
      <div class="${cls}">
        <h3 style="margin:0; color:${isBuy?'#22c55e':'#ef4444'};">${symbol} — ${dir}</h3>
        <p style="margin:5px 0;"><b>লাইভ প্রাইস (API):</b> ${price}</p>
        <p style="margin:5px 0;"><b>লজিক কনফার্মেশন:</b> ${matched}/8 টি অন-পয়েন্ট ✅</p>
        <p style="margin:5px 0;"><b>ফরেক্স TP / SL:</b> TP: <span style="color:#22c55e;">${tp}</span> | SL: <span style="color:#ef4444;">${sl}</span></p>
        <p style="font-size:11px; color:#6fffe9; margin-bottom:0;">অফিশিয়াল সিগন্যাল ইঞ্জিন (@bprahat)</p>
      </div>
    `;
  } else {
    out.innerHTML = `
      <div style="background:#0b132b; border:2px solid #ef4444; padding:12px; border-radius:10px; margin-top:10px; text-align:center;">
        <h4 style="color:#ef4444; margin:0;">❌ কোনো সিগন্যাল নেই</h4>
        <p class="small">বর্তমান প্রাইস অ্যাকশনে পর্যাপ্ত লজিক মোটে ৩/৮টি পাওয়া গেছে। মার্কেট এখন ঝুঁকিপূর্ণ।</p>
      </div>
    `;
  }
}

// র‍্যাঙ্কিং সিস্টেম জেনারেটর
function generateMarketRanking() {
  var listArea = document.getElementById('rankingList');
  listArea.innerHTML = '';

  var allPairs = [...MARKETS.fx, ...MARKETS.otc, ...MARKETS.crypto];
  // সিমুলেটেড র‍্যাঙ্কিং সোর্টিং (হাইয়েস্ট টেকনিক্যাল স্কোর অনুযায়ী)
  allPairs.sort(() => Math.random() - 0.5);

  allPairs.slice(0, 10).forEach((pair, idx) => {
    var score = 8 - Math.floor(idx / 3);
    var winRate = (94 + (10 - idx) * 0.5).toFixed(1);
    
    var html = `
      <div style="background:#0b132b; padding:12px; border-radius:10px; margin-top:8px; display:flex; justify-size:space-between; align-items:center; border:1px solid #3a506b;">
        <div>
          <span class="rank-badge">Rank #${idx + 1}</span> 
          <b style="margin-left:8px; font-size:15px;">${pair[0]}</b>
          <br><span class="small">লজিক ম্যাচ: ${score}/8 টি | স্ট্র্যাটেজি একুরেসি: ${winRate}%</span>
        </div>
        <div>
          <button style="background:#6fffe9; border:0; color:#0b132b; font-weight:bold; padding:6px 10px; border-radius:6px; cursor:pointer;" onclick="selectRankedMarket('${pair[0]}')">ট্রেড নিন</button>
        </div>
      </div>
    `;
    listArea.innerHTML += html;
  });
}

function selectRankedMarket(symbolName) {
  nav('Trade');
  // মার্কেট সিলেক্টরে খোঁজা
  var sel = document.getElementById('marketSelect');
  for(var i=0; i<sel.options.length; i++) {
    if(sel.options[i].text.includes(symbolName)) {
      sel.selectedIndex = i;
      break;
    }
  }
  loadChart();
}

// মানি ম্যানেজমেন্ট ক্যালকুলেটর
function calculateProMM() {
  var bal = parseFloat(document.getElementById('mmBalanceInput').value || 100);
  var riskPct = parseFloat(document.getElementById('mmRiskInput').value || 2);
  
  var perTradeRisk = (bal * riskPct / 100).toFixed(2);
  var maxDailyLoss = (bal * 0.06).toFixed(2); // সর্বোচ্চ ৬% দৈনিক লস
  var maxLossCount = 3; // টানা ৩টা লস হলে ট্রেড বন্ধ
  var targetProfit = (bal * 0.10).toFixed(2); // ১০% প্রফিট টার্গেট

  var out = document.getElementById('mmOutput');
  out.style.display = 'block';
  out.innerHTML = `
    <h4 style="color:#6fffe9; margin-top:0;">🛡️ আপনার অ্যাকাউন্টের রিস্ক রিপোর্ট:</h4>
    <p>🔹 <b>প্রতি ট্রেডে সর্বোচ্চ ইনভেস্ট/রিস্ক:</b> <span style="color:#ffbe0b;">$${perTradeRisk}</span> (${riskPct}%)</p>
    <p>🔹 <b>টানা কতটি ট্রেড লস হলে ট্রেড বন্ধ করবেন:</b> <span style="color:#ef4444;">${maxLossCount} টি ট্রেড</span></p>
    <p>🔹 <b>দৈনিক স্টপ লস লিমিট (Max Loss Limit):</b> <span style="color:#ef4444;">$${maxDailyLoss}</span> (৬%)</p>
    <p>🔹 <b>দৈনিক টার্গেট প্রফিট (Take Profit Target):</b> <span style="color:#22c55e;">$${targetProfit}</span> (১০%)</p>
    <p class="small" style="margin-bottom:0; color:#6fffe9;">💡 গোল্ডেন রুল: দৈনিক টার্গেট অথবা স্টপ লসে পৌঁছালে সাথে সাথে ট্রেডিং বন্ধ করে দিন।</p>
  `;
}

// লার্নিং হাবে গাইডলাইন লোড করা
